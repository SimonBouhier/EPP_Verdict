# ============================================================
# .gitignore — EPP_Verdict
# ============================================================

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# === Environnements virtuels ===
.venv/
venv/
env/
*.env

# === Caches & Tests Python ===
.hypothesis/
.mypy_cache/
.pytest_cache/
.tox/
.coverage
coverage/
*.lcov
htmlcov/
.mutmut-cache

# === Jupyter ===
.ipynb_checkpoints/

# === Data / SQLite ===
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
dump.rdb
data/backups/*.db
data/backups/*.json
*.db

# === Logs & Temporaires ===
logs/
*.log
*.tmp
*.bak
services/esmm/log_temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Audit artifacts (éphémères) ===
c3_except.log
c6_asserts.log
audit_phase4_v2.log
solana_diagnostic.ini

# === Environnement & Secrets ===
.env
.env.*
secrets.json
config.local.json
*.pem
*.keypair.json

# === IDE ===
.vscode/
.idea/
.project.settings/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
nul

# === Anchor / Solana build artifacts ===
.anchor/
target/

# === Solana test validator (hardlinks incompatibles Windows) ===
test-ledger/

# === Node ===
node_modules/

# === Claude Code ===
.claude/

# === Skills (Colosseum Copilot, etc.) ===
.agents/

# === Saves / Sessions locales ===
saves/

# === Benchmark runs (données locales, pas du code) ===
demos/benchmark_runs/

# === Slither (artefacts temporaires) ===
slither_out.json
crytic-export/

# === Solc (compilation locale) ===
*.abi
*.bin

# === ADR-014 benchmark (données éphémères, pas du code) ===
data/benchmark_audit.db

# Lockfiles — npm only
yarn.lock

# Pitch documents (pas dans le repo code)
docs/EPP_Pitch_Document*.docx

# Debug temporaire
tests/debug_acled_auth.py

# === Scripts locaux (non versionnés) ===
*.bat
all.pdf
rapport.txt

# === Plans et docs de session Opus (working docs, pas du code) ===
# NOTE : les ADR-*.md et PLAN_*.md dans docs/ sont versionnés.
# Seuls les fichiers temporaires de session sont exclus.

# === Docs locaux (working docs, pas dans le repo) ===
# Archives de sessions, to-do lists, brouillons de travail
docs/archives/
docs/To_do_list/
docs/working/
docs/drafts/

# === Sauvegardes de conversations LLM (parasites récurrents) ===
# gptoss20b, ollama, ou tout dump de session modèle
**/gptoss20b*/
**/gpt-oss*/
**/ollama_saves/
**/chat_saves/
**/conversation_*/
*_conversation.json
*_conversation.md
*_chat_history*

# === Fichiers de session Claude Code ===
# La config .claude/ est déjà ignorée, mais les branches
# créées par Claude Code peuvent laisser des artefacts
.claude_output/
*.claude_session
CLAUDE_PLAN_*.md
CLAUDE_TASK_*.md

# === Rapports d'audit éphémères (générés, pas versionnés) ===
# Les rapports définitifs vont dans docs/adr/ ou tests/audits/
AUDIT_GATEKEEPER_*.md
AUDIT_REPORT_*.md
EPP_AUDIT_REPORT_*.md
**/audit_scratch/

# === Directive de correction (consommée, pas du code) ===
DIRECTIVE_CORRECTION_*.md

# === Fichiers de résultats de scénarios (données locales) ===
# Les scripts sont versionnés, les outputs non
demos/*_results/
demos/*.json
!demos/README.md

# === Pitch documents élargis ===
docs/SECTION_PITCH_*.md
docs/EPP_Pitch_*.md
docs/*.docx
docs/*.pdf
!docs/adr/*.md

# === Windows / WSL artefacts ===
*.lnk
$RECYCLE.BIN/
*.stackdump

# === Fichiers temporaires Python courants ===
*.pickle
*.pkl
*.parquet
/.lake

# === Lean 4 build artifacts ===
.lake/

# === Lean 4 ===
.lake/
Formal/RedTests.lean
Formal/Eval.lean

# === Données locales (pas du code) ===
reports/
test_results/
data/embeddings_cache.json
data/weaver.log
data/benchmark_*.json

# === CSV/analyses kappa (artefacts locaux) ===
edges_kappa_*.csv
nodes_kappa_*.csv
kappa_*.csv
kappa_*_report.md
kappa_*_metrics.csv

# === Archives docs (working docs locaux) ===
docs/archives/
