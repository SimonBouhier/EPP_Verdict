# ============================================================
# .dockerignore — EPP_Verdict
# ============================================================
# Image Python-only : ESMM pipeline + providers + database.
# Solana programs se déploient on-chain (pas dans l'image).
# Tests et docs restent dans git mais exclus de l'image.

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
.Python
dist/
build/

# === Environnements virtuels ===
.venv/
venv/
env/
ENV/

# === Caches & Tests Python ===
.hypothesis/
.mypy_cache/
.pytest_cache/
.tox/
.coverage
coverage/
*.lcov
htmlcov/
.mutmut-cache

# === Jupyter ===
.ipynb_checkpoints/

# === Tests (pas dans l'image, restent dans git) ===
tests/
*.test.py
pytest.ini
conftest.py
epp_audit.py

# === Documentation (pas dans l'image, reste dans git) ===
docs/
*.md
!README.md

# === Data / SQLite (créées au runtime, pas embarquées) ===
data/*.db
data/*.db-shm
data/*.db-wal
data/*.backup
*.sqlite
*.sqlite3
dump.rdb

# === Logs & Temporaires ===
logs/
*.log
*.tmp
*.bak
services/esmm/log_temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Environnement & Secrets ===
.env
.env.*
secrets.json
config.local.json
*.pem
*.keypair.json

# === IDE ===
.vscode/
.idea/
.project.settings/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
nul
ehthumbs.db

# === Git ===
.git/
.gitignore

# === Anchor / Solana (déployé on-chain, pas dans l'image Python) ===
programs/
Anchor.toml
Cargo.toml
node_modules/
target/
.anchor/
test-ledger/

# === Claude Code ===
.claude/

# === Saves / Sessions / Demos ===
saves/
demos/

# === Docker (éviter récursion) ===
Dockerfile
docker-compose.yml
.dockerignore

