# ============================================================
# .dockerignore — EPP_Verdict
# ============================================================
# Exclut du contexte Docker tout ce qui n'est pas nécessaire
# à l'exécution de l'application.
# Les tests et la doc RESTENT dans git mais sont exclus de l'image.

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
.Python
dist/
build/

# === Environnements virtuels ===
.venv/
venv/
env/
ENV/

# === Caches & Tests Python ===
.mypy_cache/
.pytest_cache/
.tox/
.coverage
coverage/
*.lcov
htmlcov/

# === Jupyter ===
.ipynb_checkpoints/

# === Tests (pas dans l'image, restent dans git) ===
tests/
*.test.py
pytest.ini

# === Documentation (pas dans l'image, reste dans git) ===
docs/
*.md
!README.md

# === Data / SQLite ===
data/*.db
data/*.db-shm
data/*.db-wal
data/*.backup
*.sqlite
*.sqlite3
dump.rdb

# === Logs & Temporaires ===
logs/
*.log
*.tmp
*.bak
services/esmm/log_temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Environnement & Secrets ===
.env
.env.*
secrets.json
config.local.json

# === IDE ===
.vscode/
.idea/
.project.settings/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
nul
ehthumbs.db

# === Git ===
.git/
.gitignore

# === Anchor / Solana (pas dans l'image Python) ===
programs/
node_modules/

# === Claude Code ===
.claude/

# === Saves / Sessions locales ===
saves/
gpt-oss_20b/

# === Docker (éviter récursion) ===
Dockerfile
docker-compose.yml
.dockerignore

# === Demos & Scripts de dev ===
demos/
tools/
scripts/
*.bat
audit*.log