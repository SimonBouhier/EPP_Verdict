---
import OpalLandscape from './OpalLandscape.astro';
const { hero, title } = Astro.locals.starlightRoute.entry.data;
const lines = (hero?.title || title).split('\n');
const studies = [
  { id: 'gas', label: 'Brume', number: '01', description: 'Des formes ouvertes, légères, encore dispersées. Une étude de transparence et de mouvement.' },
  { id: 'crystal', label: 'Cristal', number: '02', description: 'Une forme se rassemble. Ses facettes gardent les nuances de la lumière qui les traverse.' },
  { id: 'humus', label: 'Humus', number: '03', description: 'La forme se défait, une pousse apparaît. La disparition laisse un sol, plutôt qu’un vide.' },
];
---

<section class="opal-hero" data-opal-study data-matter="crystal" data-paused="false" lang="fr">
  <div class="opal-edition"><span><i></i> UN ATELIER ÉPISTÉMIQUE</span><span>EPP · ÉDITION OPAL / 01</span></div>
  <div class="opal-hero-grid">
    <div class="opal-copy">
      <p class="opal-eyebrow">Explorer · Éprouver · Conserver</p>
      <h1 id="_top" data-page-title>{lines.map((line, i) => i === 0 ? <span>{line}</span> : <em>{line}</em>)}</h1>
      <p class="opal-intro">{hero?.tagline}</p>
      <div class="opal-actions">
        {hero?.actions.slice(0, 2).map((action, i) => <a class:list={['opal-link', i === 0 && 'opal-link-primary']} href={action.link}>{action.text}<span aria-hidden="true">↗</span></a>)}
      </div>
      <p class="opal-footnote"><span class="opal-fine-line"></span> Un désaccord mérite aussi de laisser une trace.</p>
    </div>
    <div class="opal-world">
      <div class="opal-world-label"><span class="opal-small-orbit" aria-hidden="true"></span> ÉTUDE DE MATIÈRE <span>FIG. 01</span></div>
      <OpalLandscape />
      <div class="opal-world-caption"><span>Paysage imaginaire · Opal Gardener</span><button type="button" data-ambient-toggle aria-pressed="false">Suspendre l’ambiance <span aria-hidden="true">Ⅱ</span></button></div>
    </div>
  </div>
  <div class="opal-study-bar">
    <div class="opal-study-switch" role="group" aria-label="Choisir une matière pour l’illustration">
      {studies.map((study) => <button type="button" data-study={study.id} data-description={study.description} aria-pressed={study.id === 'crystal'}><span>{study.number}</span>{study.label}</button>)}
    </div>
    <p data-study-description aria-live="polite">{studies[1].description}</p>
    <details class="opal-inspector">
      <summary>Lire le paysage <span aria-hidden="true">+</span></summary>
      <div><strong>Une exploration graphique</strong><p>Brume, cristal et humus sont trois compositions que vous choisissez. Les flottements sont décoratifs. Aucune mesure d’EPP ou de Lyra n’alimente cette illustration.</p><a href="/current-status/">Consulter l’état documenté du projet ↗</a></div>
    </details>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-opal-study]').forEach((study) => {
    const buttons = study.querySelectorAll<HTMLButtonElement>('[data-study]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      study.dataset.matter = button.dataset.study;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      const description = study.querySelector('[data-study-description]');
      if (description) description.textContent = button.dataset.description || '';
    }));
    const toggle = study.querySelector<HTMLButtonElement>('[data-ambient-toggle]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let userPaused = false;
    const updateMotion = () => {
      const paused = userPaused || reducedMotion.matches;
      study.dataset.paused = String(paused);
      toggle?.setAttribute('aria-pressed', String(paused));
      if (toggle) {
        toggle.disabled = reducedMotion.matches;
        toggle.textContent = reducedMotion.matches ? 'Mouvement réduit' : paused ? 'Reprendre l’ambiance ▷' : 'Suspendre l’ambiance Ⅱ';
      }
    };
    toggle?.addEventListener('click', () => { userPaused = !userPaused; updateMotion(); });
    reducedMotion.addEventListener('change', updateMotion);
    updateMotion();
  });
</script>
