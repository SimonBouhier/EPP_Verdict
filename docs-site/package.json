{
  "name": "epp-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Public documentation portal for EPP — Astro + Starlight, deployed to Vercel.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "check:sync": "node scripts/sync-docs.mjs --check",
    "test": "node --test scripts/sync-docs.test.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "^0.42.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
